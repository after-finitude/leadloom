# Default: local application, no paid services, no installation required.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
# Exact IP addresses of trusted reverse proxies; empty ignores X-Forwarded-For.
TRUSTED_PROXIES=
DATABASE_PATH=./data/leadloom.sqlite
WORKER_ENABLED=true
SEED_DEMO=true
ADMIN_EMAIL=admin@leadloom.local
ADMIN_PASSWORD=Leadloom-Demo-2026!
MANAGER_EMAIL=manager@leadloom.local
MANAGER_PASSWORD=Leadloom-Manager-2026!
WEBHOOK_SECRET=local-demo-webhook-change-before-use
# Blank creates a local key file. Live deployments MUST supply 64 hex characters.
ENCRYPTION_KEY=
LLM_PROVIDER=mock
# Required only for LLM_PROVIDER=openai; no silent fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Required only for LLM_PROVIDER=openrouter. Use a model ID with structured-output support.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
LLM_TIMEOUT_MS=15000
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_PROVIDER=mock
RESEND_API_KEY=
EMAIL_FROM=Acme <hello@example.com>
EMAIL_REPLY_TO=team@example.com
# In demo mode a real email adapter requires exact approved recipients.
EMAIL_ALLOWLIST=
# Optional live integration smoke; never runs without --confirm.
SMOKE_EMAIL=
